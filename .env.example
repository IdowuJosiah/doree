# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Square (use sandbox values for all testing)
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook subscription for payment.updated: signature key and the exact
# notification URL registered in Square.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://your-domain.com/api/webhooks/square

# Square Web Payments SDK (public, used by the checkout card form)
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=
