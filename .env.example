# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Square (use sandbox values for all testing)
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
# Webhook subscription for payment.updated: signature key and the exact
# notification URL registered in Square.
SQUARE_WEBHOOK_SIGNATURE_KEY=
SQUARE_WEBHOOK_URL=https://your-domain.com/api/webhooks/square

# Square Web Payments SDK (public, used by the checkout card form)
NEXT_PUBLIC_SQUARE_APP_ID=
NEXT_PUBLIC_SQUARE_LOCATION_ID=

# Email (Resend). Server only; never commit the key.
RESEND_API_KEY=
# Sender on your verified Resend domain, e.g. Dorée <orders@yourdomain.com>
EMAIL_FROM=
# Where new-order and contact-form alerts go (Dorée's inbox)
ORDER_NOTIFY_EMAIL=
# Public site address, used for links in emails, e.g. https://yourdomain.com
NEXT_PUBLIC_SITE_URL=
